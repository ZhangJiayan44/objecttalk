# ObjectTalk configuration. Copy to .env and fill in what you need.
# Everything is optional: with no keys the game runs fully offline
# (rule-based spatial-language engine + the 5 pre-generated Rodin objects).

# --- server ---------------------------------------------------------------
PORT=8787
# Public URL used in QR codes when deployed, e.g. https://objecttalk.example.com
PUBLIC_URL=
# Where replays and generated objects are stored
DATA_DIR=data

# --- Hyper3D Rodin (live "bring your own object" generation) ---------------
# https://hyper3d.ai/workspace/api-dashboard
RODIN_API_KEY=
RODIN_TIER=Gen-2.5-Medium

# --- Claude (optional AI layer: instruction fallback + coaching) -----------
# Explicit opt-in so the server never picks up unrelated credentials.
ENABLE_LLM=0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional proxy / gateway
# ANTHROPIC_BASE_URL=

# --- WebRTC voice link (remote duos) ----------------------------------------
# JSON array of ICE servers; add a TURN server for strict networks.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
