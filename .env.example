# ObjectTalk configuration. Copy to .env and fill in what you need.
# Everything is optional: with no keys the game runs fully offline
# (rule-based language engines + AI partners + the 57 pre-generated Rodin models).

# --- server ---------------------------------------------------------------
PORT=8787
# Public URL used in QR codes when deployed, e.g. https://objecttalk.example.com
PUBLIC_URL=
# Where replays and generated objects are stored
DATA_DIR=data

# --- Hyper3D Rodin (live "bring your own object" generation) ---------------
# https://hyper3d.ai/workspace/api-dashboard
RODIN_API_KEY=
RODIN_TIER=Gen-2.5-Medium

# --- Claude (optional AI layer) ---------------------------------------------
# The AI partner becomes a Claude tool-use agent, the coach adds rewrites and a
# CEFR check, and the Scene Agent plans levels and reviews references.
# Explicit opt-in so the server never picks up unrelated credentials.
ENABLE_LLM=0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional Anthropic-compatible gateway (plain Messages API, no betas).
# Deliberately NOT ANTHROPIC_BASE_URL, so a developer's shell never redirects the game.
# LLM_BASE_URL=
# Keep Claude for coaching only (the rule brains run the AI partner):
# LLM_PARTNER=0
# Hard deadline for one AI partner turn before the rule brain answers (ms)
# LLM_PARTNER_TIMEOUT_MS=9000

# --- WebRTC voice link (remote duos) ----------------------------------------
# JSON array of ICE servers; add a TURN server for strict networks.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
