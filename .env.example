# ObjectTalk configuration. Copy to .env and fill in what you need.
# Everything is optional: with no keys the game runs fully offline
# (rule-based language engines + AI partners + the 57 pre-generated Rodin models).
# Check your setup without spending credits: npm run agent -- doctor

# --- server ---------------------------------------------------------------
PORT=8787
# Public URL used in QR codes when deployed, e.g. https://objecttalk.example.com
PUBLIC_URL=
# Where replays and generated objects are stored
DATA_DIR=data

# --- Hyper3D Rodin ------------------------------------------------------------
# REST key for Object Studio and the Scene Agent's "rest" backend.
# Create it at https://hyper3d.ai/workspace/api-dashboard (API access needs the Business plan;
# the Techathon redemption code unlocks one month of Business).
RODIN_API_KEY=
RODIN_TIER=Gen-2.5-High
# The Scene Agent's "cli" backend uses the official Hyper3D CLI instead (no key here):
#   npm run agent -- login        (one time: approve the code in your browser)

# --- LLM (optional AI layer) ----------------------------------------------------
# The AI partner becomes a tool-use agent, the coach adds rewrites and a CEFR check,
# and the Scene Agent plans levels and reviews reference images.
#
# Option A (default): any OpenAI-compatible API. Chinese models work best here:
# DeepSeek (api.deepseek.com), Qwen (DashScope), GLM, Kimi, or a gateway that serves them.
LLM_API_KEY=
# Base URL; "/v1" is added when missing. Default: https://api.deepseek.com
# LLM_BASE_URL=
# Models per job (comma-separated = fallbacks, tried in order). Defaults:
# LLM_MODEL=deepseek-v4-flash,bailian/deepseek-v4.1-flash   # live AI partner (fast tool calls)
# LLM_COACH_MODEL=deepseek-v4-pro,deepseek-v4-flash         # post-game coach + CEFR
# LLM_PLANNER_MODEL=deepseek-v4-pro,deepseek-v4-flash       # Scene Agent level plans
# LLM_VISION_MODEL=qwen3.6-35b-a3b,qwen3.8-27b              # Scene Agent reference review (multimodal)
# Reasoning mode for these models (off keeps the live partner at ~1 s per step):
# LLM_THINKING=0
# Extra JSON merged into every request body (provider-specific switches):
# LLM_EXTRA_BODY={}
#
# Option B: Claude. Explicit opt-in so the server never picks up unrelated credentials.
# LLM_PROVIDER=anthropic
# ENABLE_LLM=1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Anthropic-compatible gateway (deliberately NOT ANTHROPIC_BASE_URL):
# ANTHROPIC_GATEWAY_URL=
#
# Both: ENABLE_LLM=0 turns the LLM layer off; LLM_PARTNER=0 keeps it for coaching only;
# LLM_PARTNER_TIMEOUT_MS (default 9000) is the deadline before the rule brain answers.

# --- WebRTC voice link (remote duos) ----------------------------------------
# JSON array of ICE servers; add a TURN server for strict networks.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
