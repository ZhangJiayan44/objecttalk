# dependencies
node_modules/

# builds
dist/
*.tsbuildinfo

# runtime data (replays, generated objects)
data/
!data/.gitkeep

# agent working files (plans and runs are reproducible; published levels live in content/levels)
agent/packs/
agent/runs/*
!agent/runs/.gitkeep

# env & secrets
.env
.env.*
!.env.example

# logs & OS
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# editors
.vscode/*
!.vscode/extensions.json
.idea/

# test output
coverage/
output/
