{
  "name": "objecttalk",
  "version": "0.1.0",
  "private": true,
  "description": "Say it clearly, so your teammate can win. A two-player 3D English-communication game: one player sees the goal, the other moves the objects.",
  "keywords": [
    "english-learning",
    "language-learning",
    "game",
    "three.js",
    "react-three-fiber",
    "socket.io",
    "multiplayer",
    "hyper3d",
    "rodin",
    "3d",
    "hackathon"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wangzh12023/objecttalk.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:https": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"vite --mode https\"",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "agent": "tsx agent/cli.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "assets:optimize": "tsx scripts/optimize-models.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@gltf-transform/core": "4.4.0",
    "@gltf-transform/extensions": "4.4.0",
    "@gltf-transform/functions": "4.4.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-tooltip": "1.2.8",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.1.1",
    "canvas-confetti": "1.9.4",
    "express": "5.2.1",
    "lucide-react": "1.48.0",
    "meshoptimizer": "0.25.0",
    "multer": "2.0.2",
    "nanoid": "5.1.6",
    "postprocessing": "6.39.4",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.4",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "sonner": "2.0.7",
    "three": "0.185.1",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@hyper3d/cli": "0.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.185.4",
    "@vitejs/plugin-basic-ssl": "2.1.0",
    "@vitejs/plugin-react": "5.1.0",
    "concurrently": "9.2.1",
    "esbuild": "0.25.12",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
